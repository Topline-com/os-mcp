{
  "name": "@topline-ai/sync",
  "version": "0.2.0",
  "description": "Topline OS sync worker — backfill + incremental sync from the CRM into per-tenant LocationDO databases.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "worker:typecheck": "tsc --noEmit -p tsconfig.worker.json",
    "pretest": "npm run build --workspace=@topline/shared --workspace=@topline/shared-auth --workspace=@topline/shared-schema --workspace=@topline/shared-do",
    "test": "tsx --test src/mapping.test.ts src/connection-auth.test.ts src/storage-isolation.test.ts"
  },
  "dependencies": {
    "@topline/shared": "*",
    "@topline/shared-auth": "*",
    "@topline/shared-do": "*",
    "@topline/shared-schema": "*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260811.1",
    "@types/node": "^20.12.0",
    "tsx": "4.23.12",
    "typescript": "^5.4.0",
    "wrangler": "4.121.0"
  },
  "engines": {
    "node": ">=22"
  }
}
